# =============================================================================
#  stock — environment configuration
# =============================================================================
#  Copy this file to `.env` and fill in the values you have.
#
#  IMPORTANT: every key below is OPTIONAL except DATABASE_URL.
#  The app starts and the dashboard works with NO keys at all — collectors that
#  lack credentials are recorded as SKIPPED (not FAILED) and simply sit out.
#  Fill a key in, restart, and that collector activates. No code changes needed.
#
#  Check what is on/off at any time:  GET /health/config
# =============================================================================

# -----------------------------------------------------------------------------
# Database  (REQUIRED — but the default below works out of the box)
# -----------------------------------------------------------------------------
# Docker Compose maps postgres to host port 5433, because this machine already
# runs a local PostgreSQL 17 on 5432. Use 5433 for the containerised DB.
DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5433/stock

# If you would rather use the PostgreSQL 17 already installed on this machine,
# create the db/role first, then use 5432 instead:
#   DATABASE_URL=postgresql+psycopg://stock:stock@localhost:5432/stock

APP_ENV=local
LOG_LEVEL=INFO
TZ=UTC

# -----------------------------------------------------------------------------
# Toss Securities Open API   https://developers.tossinvest.com
# -----------------------------------------------------------------------------
# Register an app in Toss WTS to get these, and register the IP you call from
# (unregistered IPs get HTTP 403).
# Without these: live account sync + realtime quotes are disabled. Market data
# falls back to yfinance so the dashboard still renders.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_API_BASE=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1

# -----------------------------------------------------------------------------
# Korea Investment & Securities (KIS) Open API   https://apiportal.koreainvestment.com
# -----------------------------------------------------------------------------
# Quotes only: minute bars and the live chart. No account number is read and
# nothing here places orders. KIS_ENV is "real" or "mock" (they use different
# hosts). Without these: no minute bars and no live chart; nothing else changes.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=real
# Hold KIS's real-time feed in the API process during the session, for the live chart.
LIVE_FEED_ENABLED=false

# -----------------------------------------------------------------------------
# SEC EDGAR   https://data.sec.gov     (NO API KEY NEEDED)
# -----------------------------------------------------------------------------
# SEC requires a User-Agent identifying you, with a contact address.
# Format: "<app name> <your email>"   e.g. "stock-research you@example.com"
# Rate limit is 10 req/s; exceeding it gets your IP blocked for ~10 minutes.
# Without this: the SEC collector is SKIPPED (US fundamentals unavailable).
#
# WARNING: SEC's WAF rejects some email domains outright. Verified by holding
# everything else constant and varying only the domain:
#     stock-research you@naver.com   -> 403 "Undeclared Automated Tool"
#     stock-research you@gmail.com   -> 200
# Use an address on a domain SEC accepts. Do NOT work around this by sending a
# browser User-Agent: SEC blocks undeclared automation deliberately, and
# pretending to be Chrome misrepresents the client to a government service.
SEC_USER_AGENT=

# -----------------------------------------------------------------------------
# OpenDART (Korean filings)   https://opendart.fss.or.kr    — free
# -----------------------------------------------------------------------------
# Without this: the DART collector is SKIPPED (KR fundamentals unavailable).
DART_API_KEY=

# -----------------------------------------------------------------------------
# NAVER API Hub (news / blog / cafe search + DataLab)   — free
# https://console.ncloud.com  ->  Services  ->  API Hub
#
# Not developers.naver.com. Naver stopped issuing search credentials there on
# 2026-07-31, and a Hub key sent to the old openapi.naver.com host comes back
# 401 `errorCode 024`, which reads as a wrong secret rather than a wrong
# address. The value below is the application key pair from the Hub console.
# -----------------------------------------------------------------------------
# Without these: Naver news + DataLab trend collectors are SKIPPED.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Threads (Meta) keyword search   — free, but app review required
# https://developers.facebook.com/documentation/threads/keyword-search
# -----------------------------------------------------------------------------
# Quota: 2,200 queries per user per rolling 24h.
# Without this: the Threads collector is SKIPPED.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# -----------------------------------------------------------------------------
# Reddit Data API   — free for non-commercial use, manual approval required
# https://www.reddit.com/prefs/apps
# -----------------------------------------------------------------------------
# Rate limit: 100 QPM per OAuth client (10-minute rolling average).
# Without these: the Reddit collector is SKIPPED.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-research/0.1 by u/yourname

# -----------------------------------------------------------------------------
# Sentiment scoring LLM  (OPTIONAL)
# -----------------------------------------------------------------------------
# Without a key: falls back to the deterministic rule-based scorer automatically.
# The model name is configuration, never hardcoded — it is recorded on every
# score row so forward-test results stay comparable across scorer changes.
ANTHROPIC_API_KEY=
SENTIMENT_LLM_MODEL=claude-sonnet-5
SENTIMENT_PROMPT_VERSION=v1

# -----------------------------------------------------------------------------
# Notifications  (OPTIONAL)
# -----------------------------------------------------------------------------
# Without any of these: alerts are written to the log only.
# NOTE: Kakao is not wired up. Sending KakaoTalk requires this app to become its
# own Kakao OAuth client and manage token refresh; email/webhook is the default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Discord or Slack incoming webhook URL
ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
